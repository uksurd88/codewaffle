---
import config from "@/config/config.json";
import social from "@/config/social.json";
import menu from "@/config/menu.json";

type SocialLink = { name: string; link: string };
type MenuItem = { name: string; url: string };
const mainSocial: SocialLink[] = (social as any).main ?? [];
const footerMenu: MenuItem[] = (menu as any).footer ?? [];

// Visitor count snapshot — written by scripts/snapshot-views.mjs at every build.
let snapshot: { value: number; source?: string; fetched_at?: string } = { value: 0 };
try {
  // @ts-ignore — file is created by prebuild script, may not exist on first run
  snapshot = (await import("@/data/views.json")).default;
} catch {}
const initialCount = snapshot.value || 0;
const padded = String(initialCount).padStart(7, "0").split("");
---

<footer id="cw-footer">
  <!-- Sitemap row: surfaces secondary pages (Now, Uses, Writing, Talks, etc.) -->
  <nav class="footer-nav" aria-label="Footer sitemap">
    <div class="footer-nav-label font-mono-bio">// EXPLORE</div>
    <ul class="footer-nav-list">
      {footerMenu.map((m) => (
        <li><a href={m.url} class="footer-nav-link">{m.name}</a></li>
      ))}
    </ul>
  </nav>

  <div class="cw-footer-inner">
    <div>
      <div class="footer-copy">© 2015–2026 · CODEWAFFLE</div>
      <div class="footer-tagline">Notes on AI, antibody discovery, and the data that makes both work.</div>
    </div>
    <div class="footer-links">
      {mainSocial.map((s) => (
        <a href={s.link} target="_blank" rel="noopener noreferrer" class="footer-link">
          {s.name.toUpperCase()}
        </a>
      ))}
      <a href="/blog/rss.xml" class="footer-link">RSS</a>
    </div>
  </div>

  <!-- Visitor counter: bio-futurism styled, abacus.jasoncameron.dev API -->
  <div class="cw-counter" aria-label="Visitor counter">
    <div class="counter-pulse" aria-hidden="true"></div>
    <span class="counter-label">// READS</span>
    <span class="counter-digits" id="cw-counter-digits" data-snapshot={String(initialCount)}>
      {padded.map((d, i) => (
        <span class="counter-digit" style={`animation-delay:${i * 60}ms`}>{d}</span>
      ))}
    </span>
    <span class="counter-strand" aria-hidden="true">
      <span class="strand-base">A</span><span class="strand-base alt">T</span><span class="strand-base">G</span><span class="strand-base alt">C</span><span class="strand-base">A</span><span class="strand-base alt">T</span>
    </span>
    <span class="counter-meta">since <span id="cw-counter-since">2015</span></span>
  </div>
</footer>

<script is:inline>
  // Visitor counter — abacus.jasoncameron.dev (free, no auth, simple HTTP).
  // /hit increments + returns; /get just reads. We use /hit per page load.
  (function () {
    const NAMESPACE = "sukhdeepsingh-eu";
    const KEY = "total";
    const target = document.getElementById("cw-counter-digits");
    if (!target) return;

    function pad(n) {
      const s = String(n);
      return s.padStart(7, "0");
    }

    function render(num) {
      const digits = pad(num).split("");
      target.innerHTML = digits
        .map((d, i) => `<span class="counter-digit" style="animation-delay:${i * 60}ms">${d}</span>`)
        .join("");
    }

    // Snapshot from build time is already rendered in the DOM. The runtime fetch
    // increments the counter and replaces with the live number. If the API is
    // unreachable, the build-time snapshot stays visible — never a broken state.
    const snapshot = parseInt(target.getAttribute("data-snapshot") || "0", 10);

    fetch(`https://abacus.jasoncameron.dev/hit/${NAMESPACE}/${KEY}`)
      .then((r) => r.json())
      .then((data) => {
        if (typeof data.value === "number" && data.value >= snapshot) {
          render(data.value);
        }
      })
      .catch(() => {
        // Silent — keep snapshot visible
      });
  })();
</script>

<style>
#cw-footer {
  border-top: 1px solid var(--cw-line);
  padding: 40px 40px 28px;
  margin-top: 80px;
}

/* Footer "Explore" sitemap row */
.footer-nav {
  max-width: 1400px;
  margin: 0 auto 28px;
  padding-bottom: 24px;
  border-bottom: 1px dashed var(--cw-line);
}

.footer-nav-label {
  color: var(--cw-warm);
  font-size: 11px;
  letter-spacing: 0.1em;
  margin-bottom: 12px;
}

.footer-nav-list {
  display: flex;
  flex-wrap: wrap;
  gap: 8px 28px;
  list-style: none;
  padding: 0;
  margin: 0;
}

.footer-nav-link {
  font-family: var(--font-display, 'Space Grotesk', sans-serif);
  font-size: 14px;
  color: var(--cw-ink);
  text-decoration: none;
  transition: color 0.2s, border-color 0.2s;
  padding-bottom: 2px;
  border-bottom: 1px solid transparent;
}

.footer-nav-link:hover {
  color: var(--cw-accent);
  border-bottom-color: var(--cw-accent);
}

.cw-footer-inner {
  max-width: 1400px;
  margin: 0 auto;
  display: flex;
  justify-content: space-between;
  align-items: flex-end;
  gap: 40px;
  flex-wrap: wrap;
}

.footer-copy {
  font-family: var(--font-mono, 'JetBrains Mono', monospace);
  font-size: 10px;
  letter-spacing: 0.1em;
  color: var(--cw-ink-faint);
  margin-bottom: 8px;
}

.footer-tagline {
  font-family: var(--font-display, 'Space Grotesk', sans-serif);
  font-size: 13px;
  color: var(--cw-ink-dim);
}

.footer-links {
  display: flex;
  gap: 24px;
  flex-wrap: wrap;
}

.footer-link {
  font-family: var(--font-display, 'Space Grotesk', sans-serif);
  font-size: 13px;
  color: var(--cw-ink-dim);
  text-decoration: none;
  transition: color 0.2s;
}

.footer-link:hover {
  color: var(--cw-accent);
}

/* Visitor counter */
.cw-counter {
  max-width: 1400px;
  margin: 28px auto 0;
  padding-top: 18px;
  border-top: 1px dashed var(--cw-line);
  display: flex;
  align-items: center;
  gap: 14px;
  flex-wrap: wrap;
  font-family: var(--font-mono, 'JetBrains Mono', ui-monospace, monospace);
  font-size: 11px;
  letter-spacing: 0.1em;
  color: var(--cw-ink-faint);
}

.counter-pulse {
  width: 8px;
  height: 8px;
  border-radius: 50%;
  background: var(--cw-accent);
  position: relative;
  animation: counter-blink 1.6s ease-in-out infinite;
}

.counter-pulse::after {
  content: '';
  position: absolute;
  inset: -3px;
  border-radius: 50%;
  border: 1px solid var(--cw-accent);
  opacity: 0.5;
  animation: counter-ring 1.6s ease-out infinite;
}

@keyframes counter-blink {
  0%, 100% { opacity: 1; transform: scale(1); }
  50%      { opacity: 0.55; transform: scale(0.85); }
}

@keyframes counter-ring {
  0%   { transform: scale(0.8); opacity: 0.55; }
  100% { transform: scale(2.2); opacity: 0; }
}

.counter-label {
  color: var(--cw-accent);
}

.counter-digits {
  display: inline-flex;
  gap: 2px;
  padding: 4px 8px;
  border: 1px solid var(--cw-line-strong);
  border-radius: 2px;
  background: color-mix(in srgb, var(--cw-bg-elev) 70%, transparent);
}

.counter-digit {
  display: inline-block;
  min-width: 9px;
  text-align: center;
  font-variant-numeric: tabular-nums;
  color: var(--cw-ink);
  font-weight: 600;
  font-size: 12px;
  letter-spacing: 0;
  animation: counter-flip 0.5s cubic-bezier(.2, .9, .3, 1) both;
}

@keyframes counter-flip {
  from { transform: translateY(-6px); opacity: 0; filter: blur(2px); }
  to   { transform: translateY(0);    opacity: 1; filter: blur(0); }
}

.counter-skel {
  color: var(--cw-ink-faint);
  letter-spacing: 0.3em;
}

/* Tiny ACGT strand decoration so it actually looks like the rest of the site */
.counter-strand {
  display: inline-flex;
  gap: 1px;
  padding-left: 6px;
  border-left: 1px solid var(--cw-line);
  margin-left: 4px;
}

.strand-base {
  display: inline-block;
  font-size: 9px;
  width: 11px;
  text-align: center;
  color: var(--cw-accent);
  opacity: 0.7;
  animation: strand-pulse 2.4s ease-in-out infinite;
}

.strand-base.alt {
  color: var(--cw-warm);
}

.strand-base:nth-child(2) { animation-delay: 0.2s; }
.strand-base:nth-child(3) { animation-delay: 0.4s; }
.strand-base:nth-child(4) { animation-delay: 0.6s; }
.strand-base:nth-child(5) { animation-delay: 0.8s; }
.strand-base:nth-child(6) { animation-delay: 1.0s; }

@keyframes strand-pulse {
  0%, 100% { opacity: 0.7; transform: translateY(0); }
  50%      { opacity: 0.3; transform: translateY(-1px); }
}

.counter-meta {
  color: var(--cw-ink-faint);
  margin-left: auto;
}

@media (max-width: 768px) {
  #cw-footer {
    padding: 32px 20px 24px;
    margin-top: 60px;
  }

  .cw-footer-inner {
    flex-direction: column;
    align-items: flex-start;
    gap: 20px;
  }

  .cw-counter {
    margin-top: 22px;
    gap: 10px;
  }

  .counter-meta {
    margin-left: 0;
    width: 100%;
  }
}
</style>

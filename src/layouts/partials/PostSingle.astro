---
import GiscusComments from "@/components/GiscusComments.astro";
import Share from "@/components/Share.astro";
import SimilarPosts from "@/components/SimilarPosts.astro";
import WaffleHero from "@/components/WaffleHero.astro";
import { getSinglePage } from "@/lib/contentParser.astro";
import dateFormat from "@/lib/utils/dateFormat";
import similerItems from "@/lib/utils/similarItems";
import readingTime from "@/lib/utils/readingTime";
import { humanize, markdownify, slugify } from "@/lib/utils/textConverter";
import { render } from "astro:content";

const allPosts = await getSinglePage("posts");
const { post } = Astro.props;
const similarPosts = similerItems(post, allPosts, post.slug);
const { Content } = await render(post);
const { title, description, authors, categories, image, date, tags } = post.data;

const readTime = readingTime(post.body ?? '');

const heroVariant = (() => {
  const cats = categories?.map((c: string) => c.toLowerCase()) ?? [];
  if (cats.some((c: string) => c.includes('antibody') || c.includes('science'))) return 'antibody';
  if (cats.some((c: string) => c.includes('ai') || c.includes('data'))) return 'sequence';
  if (cats.some((c: string) => c.includes('pharma') || c.includes('bio'))) return 'helix';
  return 'waffle';
})();
---

<!-- Sticky reading progress: glass DNA helix tube -->
<div id="seq-bar-wrap">
  <div class="seq-bar-inner">
    <span class="seq-label font-mono-bio" id="seq-pct">READING · 000%</span>
    <div class="seq-bar" aria-label="Reading progress">
      <div class="seq-bar-track"></div>
      <div class="seq-bar-fill" id="seq-bar-fill"></div>
      <div class="seq-bar-gloss"></div>
    </div>
    <span class="seq-readtime font-mono-bio">{readTime}</span>
  </div>
</div>

<!-- Article -->
<div id="post-scroll-area">
  <div class="post-header-wrap">
    <!-- Category badges -->
    <div class="post-cats">
      {categories?.map((cat: string) => (
        <a href={`/categories/${slugify(cat)}`} class="rt-meta-badge">
          {cat.toUpperCase()}
        </a>
      ))}
    </div>

    <!-- Title -->
    <h1 class="post-title serif-italic">{title}</h1>

    <!-- Meta row -->
    <div class="post-meta font-mono-bio">
      <span>{dateFormat(date).toUpperCase()}</span>
      <span>·</span>
      <span>SUKHI SINGH</span>
      <span>·</span>
      <span>{readTime}</span>
    </div>

    <!-- Hero viz banner -->
    <div class="post-hero-viz">
      <WaffleHero variant={heroVariant} intensity={55} height="100%" />
    </div>

    {image && (
      <img
        src={image.src ?? image}
        alt={title}
        class="post-hero-img"
        loading="lazy"
      />
    )}
  </div>

  <!-- Body -->
  <div class="post-body">
    <div class="content">
      <Content />
    </div>

    <!-- Newsletter callout -->
    <aside class="post-newsletter">
      <div class="post-nl-label font-mono-bio">// SUBSCRIBE</div>
      <h3 class="post-nl-h">Liked this? Get the next one in your inbox.</h3>
      <p class="post-nl-p">
        Weekly notes from inside antibody discovery × AI. Three things from the literature, one take, no fluff.
      </p>
      <form
        action="https://buttondown.com/api/emails/embed-subscribe/ssingh"
        method="post"
        target="popupwindow"
        onsubmit="window.open('https://buttondown.com/ssingh', 'popupwindow')"
        class="post-nl-form"
      >
        <input type="email" name="email" placeholder="you@email.com" required aria-label="Email address" class="post-nl-input" />
        <button type="submit" class="post-nl-btn">Subscribe</button>
      </form>
      <p class="post-nl-fine">No spam. One-click unsubscribe.</p>
    </aside>

    <!-- Tags + Share -->
    <div class="post-footer-row">
      <ul class="post-tags-list">
        {tags?.map((tag: string) => (
          <li class="inline-block">
            <a
              href={`/tags/${slugify(tag)}`}
              class="post-tag-pill"
            >
              #{humanize(tag)}
            </a>
          </li>
        ))}
      </ul>
      <Share
        className="social-share"
        title={title}
        description={description}
        slug={post.id}
      />
    </div>
  </div>

  <!-- Related posts -->
  {similarPosts.length > 0 && (
    <div class="related-posts">
      <div class="related-label font-mono-bio">// RELATED.SEQUENCES</div>
      <div class="related-grid">
        {similarPosts.slice(0, 2).map((p: any) => (
          <a href={`/blog/${p.id}`} class="related-card">
            <div class="related-date font-mono-bio">{dateFormat(p.data.date).toUpperCase()}</div>
            <div class="related-title serif-italic">{p.data.title}</div>
          </a>
        ))}
      </div>
    </div>
  )}
</div>

<!-- Comments -->
<GiscusComments />

<style>
/* Sequencing bar */
#seq-bar-wrap {
  position: sticky;
  top: 57px;
  z-index: 10;
  background: color-mix(in srgb, var(--rt-bg) 91%, transparent);
  backdrop-filter: blur(8px);
  border-bottom: 1px solid var(--rt-line);
  padding: 10px 40px;
}

.seq-bar-inner {
  max-width: 1200px;
  margin: 0 auto;
  display: flex;
  align-items: center;
  gap: 16px;
}

.seq-label {
  color: var(--rt-ink-faint);
  font-size: 10px;
  white-space: nowrap;
  min-width: 90px;
}

.seq-bar {
  flex: 1;
  height: 14px;
  position: relative;
  border-radius: 999px;
  background: linear-gradient(180deg,
    color-mix(in srgb, var(--rt-bg-elev) 92%, transparent),
    color-mix(in srgb, var(--rt-bg) 90%, transparent));
  border: 1px solid var(--rt-line);
  overflow: hidden;
  box-shadow:
    inset 0 1px 1.5px rgba(20, 30, 50, 0.05),
    inset 0 -1px 1px rgba(255, 255, 255, 0.4);
}

.seq-bar-track,
.seq-bar-fill {
  position: absolute;
  inset: 0;
  background-repeat: repeat-x;
  background-size: 36px 14px;
  background-position: left center;
}

.seq-bar-track {
  background-image: url("data:image/svg+xml;utf8,<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 36 14' preserveAspectRatio='none'><path d='M0 7 Q9 12 18 7 T36 7' fill='none' stroke='%231a2336' stroke-opacity='0.28' stroke-width='1' stroke-linecap='round'/><path d='M0 7 Q9 2 18 7 T36 7' fill='none' stroke='%231a2336' stroke-opacity='0.28' stroke-width='1' stroke-linecap='round'/><line x1='9' y1='3.5' x2='9' y2='10.5' stroke='%231a2336' stroke-opacity='0.2' stroke-width='0.8' stroke-linecap='round'/><line x1='27' y1='3.5' x2='27' y2='10.5' stroke='%231a2336' stroke-opacity='0.2' stroke-width='0.8' stroke-linecap='round'/></svg>");
}

.seq-bar-fill {
  width: 0%;
  transition: width 0.2s cubic-bezier(.2, .7, .3, 1);
  background-image: url("data:image/svg+xml;utf8,<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 36 14' preserveAspectRatio='none'><path d='M0 7 Q9 12 18 7 T36 7' fill='none' stroke='%23178F84' stroke-width='1.4' stroke-linecap='round'/><path d='M0 7 Q9 2 18 7 T36 7' fill='none' stroke='%23B87A28' stroke-width='1.4' stroke-linecap='round'/><line x1='9' y1='3' x2='9' y2='11' stroke='%23178F84' stroke-width='1.1' stroke-linecap='round'/><line x1='27' y1='3' x2='27' y2='11' stroke='%23B87A28' stroke-width='1.1' stroke-linecap='round'/></svg>");
}

.seq-bar-gloss {
  position: absolute;
  inset: 0;
  pointer-events: none;
  border-radius: 999px;
  background: linear-gradient(180deg,
    rgba(255, 255, 255, 0.42) 0%,
    rgba(255, 255, 255, 0.08) 38%,
    rgba(255, 255, 255, 0) 55%,
    rgba(20, 30, 50, 0.06) 100%);
}

.dark .seq-bar-track {
  background-image: url("data:image/svg+xml;utf8,<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 36 14' preserveAspectRatio='none'><path d='M0 7 Q9 12 18 7 T36 7' fill='none' stroke='%23e6ecf5' stroke-opacity='0.22' stroke-width='1' stroke-linecap='round'/><path d='M0 7 Q9 2 18 7 T36 7' fill='none' stroke='%23e6ecf5' stroke-opacity='0.22' stroke-width='1' stroke-linecap='round'/><line x1='9' y1='3.5' x2='9' y2='10.5' stroke='%23e6ecf5' stroke-opacity='0.16' stroke-width='0.8' stroke-linecap='round'/><line x1='27' y1='3.5' x2='27' y2='10.5' stroke='%23e6ecf5' stroke-opacity='0.16' stroke-width='0.8' stroke-linecap='round'/></svg>");
}

.dark .seq-bar-fill {
  background-image: url("data:image/svg+xml;utf8,<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 36 14' preserveAspectRatio='none'><path d='M0 7 Q9 12 18 7 T36 7' fill='none' stroke='%236FE3D8' stroke-width='1.4' stroke-linecap='round'/><path d='M0 7 Q9 2 18 7 T36 7' fill='none' stroke='%23E8B168' stroke-width='1.4' stroke-linecap='round'/><line x1='9' y1='3' x2='9' y2='11' stroke='%236FE3D8' stroke-width='1.1' stroke-linecap='round'/><line x1='27' y1='3' x2='27' y2='11' stroke='%23E8B168' stroke-width='1.1' stroke-linecap='round'/></svg>");
}

.dark .seq-bar-gloss {
  background: linear-gradient(180deg,
    rgba(255, 255, 255, 0.12) 0%,
    rgba(255, 255, 255, 0.02) 40%,
    rgba(0, 0, 0, 0.18) 100%);
}

.seq-readtime {
  color: var(--rt-ink-faint);
  font-size: 10px;
  white-space: nowrap;
}

/* Post layout */
.post-header-wrap {
  max-width: 760px;
  margin: 0 auto;
  padding: 80px 40px 40px;
}

.post-cats {
  display: flex;
  gap: 10px;
  margin-bottom: 28px;
  flex-wrap: wrap;
}

.post-title {
  font-family: var(--font-serif, 'Instrument Serif', serif);
  font-style: italic;
  font-weight: 400;
  font-size: clamp(36px, 5vw, 56px);
  line-height: 1.05;
  margin-bottom: 24px;
  letter-spacing: -0.01em;
  color: var(--rt-ink);
}

.post-meta {
  display: flex;
  gap: 16px;
  flex-wrap: wrap;
  color: var(--rt-ink-dim);
  font-size: 11px;
  margin-bottom: 40px;
}

.post-hero-viz {
  position: relative;
  height: 220px;
  margin: 40px 0 60px;
  background: var(--rt-bg-elev);
  border: 1px solid var(--rt-line);
  overflow: hidden;
}

.post-hero-img {
  width: 100%;
  height: auto;
  border-radius: 2px;
  margin-bottom: 40px;
}

.post-body {
  max-width: 760px;
  margin: 0 auto;
  padding: 0 40px 60px;
}

.post-footer-row {
  display: flex;
  flex-wrap: wrap;
  align-items: center;
  justify-content: space-between;
  gap: 16px;
  margin-top: 48px;
  padding-top: 24px;
  border-top: 1px solid var(--rt-line);
}

.post-tags-list {
  display: flex;
  flex-wrap: wrap;
  gap: 8px;
  list-style: none;
  padding: 0;
  margin: 0;
}

.post-tag-pill {
  display: block;
  border-radius: 2px;
  background: var(--rt-bg-elev);
  border: 1px solid var(--rt-line);
  padding: 4px 12px;
  font-family: var(--font-mono, 'JetBrains Mono', monospace);
  font-size: 11px;
  color: var(--rt-ink-dim);
  text-decoration: none;
  transition: border-color 0.2s, color 0.2s;
}

.post-tag-pill:hover {
  border-color: var(--rt-accent);
  color: var(--rt-accent);
}

/* Post newsletter callout */
.post-newsletter {
  margin: 56px 0 32px;
  padding: 32px 32px 28px;
  border: 1px solid var(--rt-line-strong);
  border-left: 3px solid var(--rt-accent);
  background: var(--rt-bg-elev);
  border-radius: 4px;
}

.post-nl-label {
  color: var(--rt-accent);
  font-size: 11px;
  letter-spacing: 0.1em;
  margin-bottom: 8px;
}

.post-nl-h {
  font-family: var(--font-display, 'Space Grotesk', sans-serif);
  font-size: 22px;
  letter-spacing: -0.01em;
  margin: 0 0 8px;
  color: var(--rt-ink);
}

.post-nl-p {
  font-size: 14px;
  line-height: 1.55;
  color: var(--rt-ink-dim);
  margin: 0 0 16px;
}

.post-nl-form {
  display: flex;
  gap: 8px;
  margin-bottom: 8px;
}

.post-nl-input {
  flex: 1;
  padding: 11px 14px;
  font-size: 14px;
  font-family: inherit;
  border: 1px solid var(--rt-line-strong);
  background: var(--rt-bg);
  color: var(--rt-ink);
  border-radius: 4px;
  outline: none;
}

.post-nl-input:focus { border-color: var(--rt-accent); }

.post-nl-btn {
  padding: 11px 20px;
  font-size: 13px;
  font-weight: 600;
  font-family: var(--font-display, 'Space Grotesk', sans-serif);
  letter-spacing: 0.02em;
  border: none;
  background: var(--rt-accent);
  color: var(--rt-bg);
  cursor: pointer;
  border-radius: 4px;
}

.post-nl-btn:hover { opacity: 0.85; }

.post-nl-fine {
  font-size: 11px;
  color: var(--rt-ink-faint);
  margin: 0;
}

@media (max-width: 600px) {
  .post-newsletter { padding: 24px 20px; }
  .post-nl-form { flex-direction: column; }
}

/* Related posts */
.related-posts {
  max-width: 1200px;
  margin: 80px auto 40px;
  padding: 0 40px;
}

.related-label {
  color: var(--rt-accent);
  font-size: 11px;
  letter-spacing: 0.1em;
  margin-bottom: 24px;
}

.related-grid {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 24px;
}

.related-card {
  display: block;
  padding: 24px;
  border: 1px solid var(--rt-line);
  text-decoration: none;
  transition: border-color 0.2s;
}

.related-card:hover {
  border-color: var(--rt-accent);
}

.related-date {
  color: var(--rt-ink-dim);
  font-size: 10px;
  margin-bottom: 8px;
}

.related-title {
  font-family: var(--font-serif, 'Instrument Serif', serif);
  font-style: italic;
  font-size: 22px;
  line-height: 1.15;
  color: var(--rt-ink);
  transition: color 0.2s;
  font-weight: 400;
}

.related-card:hover .related-title {
  color: var(--rt-accent);
}

@media (max-width: 768px) {
  #seq-bar-wrap { padding: 10px 20px; }
  .post-header-wrap { padding: 60px 20px 32px; }
  .post-body { padding: 0 20px 40px; }
  .related-posts { padding: 0 20px; }
  .related-grid { grid-template-columns: 1fr; }
}
</style>

<script>
function initSequencingBar() {
  const fill = document.getElementById('seq-bar-fill');
  const pct = document.getElementById('seq-pct');
  const scrollArea = document.getElementById('post-scroll-area');
  if (!fill || !pct || !scrollArea) return;

  const onScroll = () => {
    const rect = scrollArea.getBoundingClientRect();
    const total = scrollArea.scrollHeight - window.innerHeight;
    const progress = total > 0 ? Math.min(1, Math.max(0, -rect.top / total)) : 0;
    const p = Math.round(progress * 100);
    pct.textContent = `READING · ${String(p).padStart(3, '0')}%`;
    fill.style.width = `${progress * 100}%`;
  };

  onScroll();
  window.addEventListener('scroll', onScroll, { passive: true });
  return () => window.removeEventListener('scroll', onScroll);
}

let cleanup: (() => void) | undefined;

function init() {
  cleanup?.();
  cleanup = initSequencingBar() ?? undefined;
}

init();
document.addEventListener('astro:after-swap', init);
</script>

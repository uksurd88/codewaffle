---
import menu from "@/config/menu.json";

export interface NavigationLink {
  name: string;
  url: string;
}

const { main }: { main: NavigationLink[] } = menu;
const currentPath = Astro.url.pathname;
---

<header id="cw-header">
  <nav>
    <!-- Brand -->
    <a href="/" class="cw-brand" aria-label="CodeWaffle home">
      <svg width="28" height="28" viewBox="0 0 28 28" fill="none" aria-hidden="true">
        <rect x="1" y="1" width="26" height="26" rx="2" stroke="var(--cw-accent)" stroke-width="1.2" opacity="0.5" />
        <rect x="4"  y="4"  width="5" height="5" rx="0.5" fill="var(--cw-accent)" opacity="0.9" />
        <rect x="11" y="4"  width="5" height="5" rx="0.5" fill="var(--cw-accent)" opacity="0.35" />
        <rect x="18" y="4"  width="5" height="5" rx="0.5" fill="var(--cw-accent)" opacity="0.9" />
        <rect x="4"  y="11" width="5" height="5" rx="0.5" fill="var(--cw-accent)" opacity="0.35" />
        <rect x="11" y="11" width="5" height="5" rx="0.5" fill="var(--cw-accent)" opacity="0.9" />
        <rect x="18" y="11" width="5" height="5" rx="0.5" fill="var(--cw-accent)" opacity="0.35" />
        <rect x="4"  y="18" width="5" height="5" rx="0.5" fill="var(--cw-accent)" opacity="0.9" />
        <rect x="11" y="18" width="5" height="5" rx="0.5" fill="var(--cw-accent)" opacity="0.35" />
        <rect x="18" y="18" width="5" height="5" rx="0.5" fill="var(--cw-accent)" opacity="0.9" />
      </svg>
      <div>
        <div class="brand-name">CODEWAFFLE</div>
        <div class="brand-sub">SUKHI · SINGH / ENGINEER</div>
      </div>
    </a>

    <!-- Desktop nav -->
    <ul class="cw-nav-links">
      {main.map((item) => {
        const isActive = item.url === '/'
          ? currentPath === '/' || currentPath === ''
          : currentPath.startsWith(item.url);
        return (
          <li>
            <a href={item.url} class={`cw-nav-link${isActive ? ' active' : ''}`}>
              {item.name}
            </a>
          </li>
        );
      })}
    </ul>

    <!-- Right controls -->
    <div class="cw-nav-right">
      <a href="/search" class="cw-icon-btn" aria-label="Search" title="Search">
        <svg width="16" height="16" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.4" stroke-linecap="round">
          <circle cx="6.5" cy="6.5" r="4.5" />
          <line x1="10.5" y1="10.5" x2="14" y2="14" />
        </svg>
      </a>
      <button id="cw-theme-toggle" class="cw-icon-btn" aria-label="Toggle theme" title="Toggle light/dark">
        <svg id="cw-icon-moon" width="14" height="14" viewBox="0 0 14 14" fill="currentColor">
          <path d="M7 2a5 5 0 105 5 4 4 0 01-5-5z"/>
        </svg>
        <svg id="cw-icon-sun" width="14" height="14" viewBox="0 0 14 14" fill="none" stroke="currentColor" stroke-width="1.3" style="display:none">
          <circle cx="7" cy="7" r="2.8"/>
          <path d="M7 1v1.5M7 11.5V13M1 7h1.5M11.5 7H13M2.5 2.5l1 1M10.5 10.5l1 1M2.5 11.5l1-1M10.5 3.5l1-1"/>
        </svg>
      </button>

      <!-- Mobile menu toggle -->
      <button id="cw-mobile-toggle" class="cw-icon-btn cw-mobile-only" aria-label="Open menu">
        <svg width="18" height="18" viewBox="0 0 18 18" fill="none" stroke="currentColor" stroke-width="1.4" stroke-linecap="round">
          <line x1="2" y1="5" x2="16" y2="5"/>
          <line x1="2" y1="9" x2="16" y2="9"/>
          <line x1="2" y1="13" x2="16" y2="13"/>
        </svg>
      </button>
    </div>
  </nav>

  <!-- Mobile nav drawer -->
  <div id="cw-mobile-nav" class="cw-mobile-nav" hidden>
    <ul>
      {main.map((item) => (
        <li><a href={item.url} class="cw-mobile-link">{item.name}</a></li>
      ))}
    </ul>
  </div>
</header>

<style>
#cw-header {
  position: sticky;
  top: 0;
  z-index: 50;
  background: color-mix(in srgb, var(--cw-bg) 88%, transparent);
  backdrop-filter: blur(12px);
  -webkit-backdrop-filter: blur(12px);
  border-bottom: 1px solid var(--cw-line);
}

#cw-header nav {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 24px;
  padding: 14px 40px;
  max-width: 1400px;
  margin: 0 auto;
}

.cw-brand {
  display: flex;
  align-items: center;
  gap: 10px;
  text-decoration: none;
  color: var(--cw-ink);
  flex-shrink: 0;
}

.brand-name {
  font-family: var(--font-display, 'Space Grotesk', sans-serif);
  font-weight: 700;
  font-size: 16px;
  letter-spacing: -0.02em;
  color: var(--cw-ink);
  line-height: 1.2;
}

.brand-sub {
  font-family: var(--font-mono, 'JetBrains Mono', monospace);
  font-size: 9px;
  letter-spacing: 0.1em;
  color: var(--cw-ink-faint);
  line-height: 1;
}

.cw-nav-links {
  display: flex;
  align-items: center;
  gap: 28px;
  list-style: none;
  margin: 0;
  padding: 0;
}

.cw-nav-link {
  font-family: var(--font-display, 'Space Grotesk', sans-serif);
  font-weight: 500;
  font-size: 13px;
  color: var(--cw-ink-dim);
  text-decoration: none;
  padding-bottom: 3px;
  border-bottom: 1.5px solid transparent;
  transition: color 0.2s, border-color 0.2s;
  white-space: nowrap;
}

.cw-nav-link:hover,
.cw-nav-link.active {
  color: var(--cw-ink);
}

.cw-nav-link.active {
  border-bottom-color: var(--cw-accent);
}

.cw-nav-right {
  display: flex;
  align-items: center;
  gap: 8px;
  flex-shrink: 0;
}

.cw-icon-btn {
  background: transparent;
  border: 1px solid var(--cw-line);
  width: 32px;
  height: 32px;
  border-radius: 50%;
  color: var(--cw-ink);
  cursor: pointer;
  display: flex;
  align-items: center;
  justify-content: center;
  text-decoration: none;
  transition: border-color 0.2s, color 0.2s;
}

.cw-icon-btn:hover {
  border-color: var(--cw-accent);
  color: var(--cw-accent);
}

/* Mobile nav */
.cw-mobile-only {
  display: none;
}

.cw-mobile-nav {
  border-top: 1px solid var(--cw-line);
  padding: 16px 40px 20px;
}

.cw-mobile-nav ul {
  list-style: none;
  margin: 0;
  padding: 0;
  display: flex;
  flex-direction: column;
  gap: 4px;
}

.cw-mobile-link {
  display: block;
  padding: 10px 0;
  font-family: var(--font-display, 'Space Grotesk', sans-serif);
  font-weight: 500;
  font-size: 15px;
  color: var(--cw-ink-dim);
  text-decoration: none;
  border-bottom: 1px solid var(--cw-line);
}

.cw-mobile-link:hover {
  color: var(--cw-accent);
}

@media (max-width: 768px) {
  #cw-header nav {
    padding: 12px 20px;
  }

  .cw-nav-links {
    display: none;
  }

  .cw-mobile-only {
    display: flex;
  }

  .cw-mobile-nav {
    padding: 12px 20px 16px;
  }
}
</style>

<script>
  function initHeader() {
    const toggle = document.getElementById('cw-theme-toggle');
    const moon = document.getElementById('cw-icon-moon');
    const sun = document.getElementById('cw-icon-sun');
    const mobileToggle = document.getElementById('cw-mobile-toggle');
    const mobileNav = document.getElementById('cw-mobile-nav');

    function syncIcons() {
      const isDark = document.documentElement.classList.contains('dark');
      if (moon) moon.style.display = isDark ? 'block' : 'none';
      if (sun) sun.style.display = isDark ? 'none' : 'block';
    }

    syncIcons();

    toggle?.addEventListener('click', () => {
      const isDark = document.documentElement.classList.toggle('dark');
      try { localStorage.setItem('theme', isDark ? 'dark' : 'light'); } catch (_) {}
      syncIcons();
    });

    mobileToggle?.addEventListener('click', () => {
      const hidden = mobileNav?.hasAttribute('hidden');
      if (hidden) {
        mobileNav?.removeAttribute('hidden');
      } else {
        mobileNav?.setAttribute('hidden', '');
      }
    });
  }

  initHeader();
  document.addEventListener('astro:after-swap', initHeader);
</script>

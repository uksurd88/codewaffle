---
// Buttondown newsletter signup - free tier at buttondown.email
// Replace ssingh with your Buttondown username after signing up
---

<section class="section bg-light">
  <div class="container">
    <div class="row justify-center text-center">
      <div class="md:col-8 lg:col-6">
        <h3 class="mb-3">Stay in the loop</h3>
        <p class="mb-6 text-text">
          New posts on science, AI, bioinformatics and life. No spam, unsubscribe anytime.
        </p>
        <form
          action="https://buttondown.email/api/emails/embed-subscribe/ssingh"
          method="post"
          target="popupwindow"
          onsubmit="window.open('https://buttondown.email/ssingh','popupwindow')"
          class="flex flex-col sm:flex-row gap-3 justify-center"
        >
          <input
            type="email"
            name="email"
            placeholder="your@email.com"
            required
            class="form-input flex-1 max-w-sm rounded-lg border border-border px-4 py-3 focus:border-primary focus:outline-none"
          />
          <button
            type="submit"
            class="btn btn-primary px-6 py-3 rounded-lg font-semibold transition-all"
          >
            Subscribe
          </button>
        </form>
        <p class="mt-3 text-sm text-text/60">Powered by Buttondown</p>
      </div>
    </div>
  </div>
</section>

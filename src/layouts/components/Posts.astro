---
import dateFormat from "@/lib/utils/dateFormat";
import { slugify } from "@/lib/utils/textConverter";
import readingTime from "@/lib/utils/readingTime";
import type { CollectionEntry } from "astro:content";

type Props = {
  posts: CollectionEntry<"posts">[];
  className?: string;
  fluid?: boolean;
};

const { className, posts } = Astro.props;

const postsWithTime = posts.map((p) => ({
  ...p,
  readMin: readingTime(p.body ?? ''),
}));

// Pre-compute DNA spine SVG paths in frontmatter
const totalHeight = posts.length * 160 + 40;
const steps = Math.floor(totalHeight / 14);
const amp = 18;
const cx = 60;
const pathAPoints: string[] = [];
const pathBPoints: string[] = [];

type Rung = { x1: number; x2: number; y: number; idx: number };
const rungs: Rung[] = [];

for (let i = 0; i <= steps; i++) {
  const y = (i / steps) * totalHeight;
  const phase = (i / steps) * Math.PI * 10;
  pathAPoints.push(`${i === 0 ? 'M' : 'L'}${(cx + Math.sin(phase) * amp).toFixed(1)},${y.toFixed(1)}`);
  pathBPoints.push(`${i === 0 ? 'M' : 'L'}${(cx + Math.sin(phase + Math.PI) * amp).toFixed(1)},${y.toFixed(1)}`);
}

for (let i = 0; i <= steps; i += 2) {
  const y = (i / steps) * totalHeight;
  const phase = (i / steps) * Math.PI * 10;
  rungs.push({
    x1: cx + Math.sin(phase) * amp,
    x2: cx + Math.sin(phase + Math.PI) * amp,
    y,
    idx: i,
  });
}

const pathA = pathAPoints.join('');
const pathB = pathBPoints.join('');
---

<div class={`rt-dna-timeline ${className ?? ''}`}>
  <!-- DNA spine SVG (server-rendered, hover state handled via CSS) -->
  <div class="dna-spine-wrap" aria-hidden="true">
    <svg
      class="dna-spine-svg"
      viewBox={`0 0 120 ${totalHeight}`}
      preserveAspectRatio="none"
      fill="none"
      xmlns="http://www.w3.org/2000/svg"
    >
      <defs>
        <linearGradient id="dnaGradA" x1="0" y1="0" x2="0" y2="1">
          <stop offset="0%" stop-color="var(--rt-accent)" stop-opacity="0.9"/>
          <stop offset="100%" stop-color="var(--rt-accent)" stop-opacity="0.2"/>
        </linearGradient>
        <linearGradient id="dnaGradB" x1="0" y1="0" x2="0" y2="1">
          <stop offset="0%" stop-color="var(--rt-warm)" stop-opacity="0.8"/>
          <stop offset="100%" stop-color="var(--rt-warm)" stop-opacity="0.15"/>
        </linearGradient>
      </defs>
      <path d={pathA} stroke="url(#dnaGradA)" stroke-width="1.5" />
      <path d={pathB} stroke="url(#dnaGradB)" stroke-width="1.5" />
      {rungs.map((r) => (
        <line
          class="dna-rung"
          x1={r.x1.toFixed(1)}
          y1={r.y.toFixed(1)}
          x2={r.x2.toFixed(1)}
          y2={r.y.toFixed(1)}
          stroke="currentColor"
          stroke-width="0.8"
          opacity="0.3"
        />
      ))}
    </svg>
  </div>

  <!-- Post rows -->
  {postsWithTime.map((post, i) => (
    <article
      class="dna-post-row"
      data-idx={i}
      data-href={`/blog/${post.id}`}
    >
      <div class="post-meta-col">
        <div class="post-num font-mono-bio">{String(i + 1).padStart(3, '0')}</div>
        <div class="post-date">{dateFormat(post.data.date!)}</div>
      </div>
      <div class="post-body-col">
        <div class="post-tags">
          {post.data.categories.slice(0, 2).map((cat) => (
            <a
              href={`/categories/${slugify(cat)}`}
              class="post-tag font-mono-bio"
              onclick="event.stopPropagation()"
            >
              {cat.toUpperCase()}
            </a>
          ))}
          <span class="post-readtime font-mono-bio">{post.readMin}</span>
        </div>
        <h3 class="post-title">{post.data.title}</h3>
        <p class="post-excerpt">{post.data.description ?? ''}</p>
      </div>
      <div class="post-antibody-col" aria-hidden="true">
        <svg class="antibody-icon" viewBox="0 0 40 40" fill="none" xmlns="http://www.w3.org/2000/svg">
          <line x1="20" y1="22" x2="20" y2="36" stroke="currentColor" stroke-width="2" stroke-linecap="round"/>
          <line x1="20" y1="22" x2="8" y2="10" stroke="currentColor" stroke-width="2" stroke-linecap="round"/>
          <line x1="20" y1="22" x2="32" y2="10" stroke="currentColor" stroke-width="2" stroke-linecap="round"/>
          <circle cx="20" cy="22" r="2.5" fill="currentColor"/>
          <circle cx="8" cy="10" r="3" fill="currentColor"/>
          <circle cx="32" cy="10" r="3" fill="currentColor"/>
          <circle cx="20" cy="36" r="2.5" fill="currentColor"/>
          <circle cx="8" cy="10" r="3" stroke="currentColor" stroke-width="0.8" class="pulse-ring pulse-ring-l" opacity="0" fill="none"/>
          <circle cx="32" cy="10" r="3" stroke="currentColor" stroke-width="0.8" class="pulse-ring pulse-ring-r" opacity="0" fill="none"/>
        </svg>
      </div>
    </article>
  ))}
</div>

<style>
.rt-dna-timeline {
  position: relative;
  padding-left: 140px;
}

.dna-spine-wrap {
  position: absolute;
  left: 0;
  top: 0;
  width: 120px;
  height: 100%;
  color: var(--rt-ink-faint);
  pointer-events: none;
}

.dna-spine-svg {
  width: 120px;
  height: 100%;
}

.dna-post-row {
  display: grid;
  grid-template-columns: 100px 1fr 64px;
  gap: 32px;
  align-items: center;
  min-height: 160px;
  border-bottom: 1px solid var(--rt-line);
  padding: 20px 8px 20px 20px;
  cursor: pointer;
  transition: background 0.25s;
  position: relative;
  text-decoration: none;
  color: inherit;
}

.dna-post-row:hover {
  background: color-mix(in srgb, var(--rt-accent) 5%, transparent);
}

.post-meta-col {
  display: flex;
  flex-direction: column;
  gap: 6px;
}

.post-num {
  color: var(--rt-ink-faint);
  font-size: 10px;
}

.post-date {
  font-family: var(--font-display, 'Space Grotesk', sans-serif);
  font-size: 13px;
  color: var(--rt-ink-dim);
}

.post-tags {
  display: flex;
  gap: 10px;
  margin-bottom: 10px;
  flex-wrap: wrap;
  align-items: center;
}

.post-tag {
  color: var(--rt-ink-dim);
  font-size: 10px;
  letter-spacing: 0.1em;
  text-decoration: none;
  transition: color 0.2s;
}

.post-tag:hover {
  color: var(--rt-accent);
}

.post-readtime {
  color: var(--rt-ink-faint);
  font-size: 10px;
}

.post-title {
  font-family: var(--font-serif, 'Instrument Serif', serif);
  font-style: italic;
  font-weight: 400;
  font-size: 26px;
  line-height: 1.15;
  margin: 0 0 8px;
  color: var(--rt-ink);
  transition: color 0.2s;
  letter-spacing: -0.01em;
}

.dna-post-row:hover .post-title {
  color: var(--rt-accent);
}

.post-excerpt {
  color: var(--rt-ink-dim);
  font-size: 14px;
  max-width: 580px;
  overflow: hidden;
  text-overflow: ellipsis;
  display: -webkit-box;
  -webkit-line-clamp: 1;
  -webkit-box-orient: vertical;
  margin: 0;
}

.post-antibody-col {
  display: flex;
  justify-content: flex-end;
  align-items: center;
  color: var(--rt-ink-faint);
  transition: color 0.25s;
}

.dna-post-row:hover .post-antibody-col {
  color: var(--rt-accent);
}

.antibody-icon {
  width: 48px;
  height: 48px;
  transition: transform 0.4s cubic-bezier(0.2, 0.7, 0.3, 1);
}

.dna-post-row:hover .antibody-icon {
  transform: rotate(-8deg) scale(1.12);
}

.dna-post-row:hover .pulse-ring-l,
.dna-post-row:hover .pulse-ring-r {
  animation: pulse-out 1.2s ease-out infinite;
}

.dna-post-row:hover .pulse-ring-r {
  animation-delay: 0.2s;
}

@keyframes pulse-out {
  0%   { r: 3; opacity: 0.5; }
  100% { r: 9; opacity: 0; }
}

@media (max-width: 768px) {
  .rt-dna-timeline {
    padding-left: 0;
  }

  .dna-spine-wrap {
    display: none;
  }

  .dna-post-row {
    grid-template-columns: 1fr 40px;
    gap: 16px;
    min-height: 120px;
  }

  .post-meta-col {
    display: none;
  }
}
</style>

<script>
function initTimeline() {
  document.querySelectorAll<HTMLElement>('.dna-post-row').forEach(row => {
    if (row.dataset.tlInit) return;
    row.dataset.tlInit = '1';
    row.addEventListener('click', (e) => {
      const target = e.target as HTMLElement;
      if (target.closest('a') && target.closest('a') !== row) return;
      const href = row.dataset.href;
      if (href) window.location.href = href;
    });
  });
}

initTimeline();
document.addEventListener('astro:after-swap', () => {
  document.querySelectorAll<HTMLElement>('.dna-post-row').forEach(r => delete r.dataset.tlInit);
  initTimeline();
});
</script>

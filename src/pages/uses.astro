---
import Base from "@/layouts/Base.astro";

const groups = [
  {
    label: "DAILY DRIVERS",
    items: [
      { name: "MacBook Pro", note: "primary machine" },
      { name: "VS Code + Claude Code", note: "writing, code, side projects" },
      { name: "Obsidian", note: "second brain, daily notes, weekly reviews" },
      { name: "iA Writer", note: "long-form drafting" },
      { name: "Raycast", note: "launcher, snippets, AI commands" },
    ],
  },
  {
    label: "WORK",
    items: [
      { name: "Jira + Confluence", note: "ENPICOM project management" },
      { name: "Outlook + Teams", note: "email, calls, async chat" },
      { name: "Notion", note: "consulting + RadTech docs" },
      { name: "n8n", note: "automation glue between APIs" },
      { name: "Anthropic Claude", note: "writing, code, research synthesis" },
    ],
  },
  {
    label: "BIOINFORMATICS & DATA",
    items: [
      { name: "Python + Jupyter", note: "analysis, prototyping" },
      { name: "R + tidyverse", note: "stats, visualization" },
      { name: "PubMed E-utils + NewsAPI", note: "literature feeds" },
      { name: "ENPICOM IGX Platform", note: "antibody discovery, repertoire" },
      { name: "AlphaFold / ESM", note: "structure prediction" },
    ],
  },
  {
    label: "CONTENT & SOCIAL",
    items: [
      { name: "Astro + GitHub Pages", note: "this site" },
      { name: "Buttondown", note: "newsletter" },
      { name: "Giscus", note: "comments" },
      { name: "Umami", note: "privacy-friendly analytics" },
      { name: "LinkedIn", note: "primary audience channel" },
    ],
  },
  {
    label: "OFF DESK",
    items: [
      { name: "Pioneer DJ controller", note: "house, electronica" },
      { name: "Salomon trail shoes", note: "hikes, frisbee" },
      { name: "Kindle Paperwhite", note: "long reads" },
      { name: "Bose QC headphones", note: "deep work + travel" },
    ],
  },
];
---

<Base
  title="Uses"
  meta_title="Uses — Sukhi Singh"
  description="Hardware, software, and tools Sukhi Singh uses every day for science, AI, writing, and life."
>
  <section class="uses-section">
    <div class="uses-container">
      <div class="uses-label">// USES</div>
      <h1 class="uses-h1">Tools &amp; setup</h1>
      <p class="uses-lede">
        What I actually use, day in and day out. In the spirit of <a href="https://uses.tech" target="_blank" rel="noopener">uses.tech</a>. No affiliate links — just the kit that works for me.
      </p>

      <div class="uses-grid">
        {groups.map((g) => (
          <div class="uses-block">
            <div class="uses-block-label">{`// ${g.label}`}</div>
            <ul class="uses-list">
              {g.items.map((i: any) => (
                <li>
                  <span class="uses-name">{i.name}</span>
                  {i.note && <span class="uses-note"> — {i.note}</span>}
                </li>
              ))}
            </ul>
          </div>
        ))}
      </div>
    </div>
  </section>
</Base>

<style>
.uses-section { padding: 60px 0 100px; }

.uses-container {
  max-width: 900px;
  margin: 0 auto;
  padding: 0 40px;
}

.uses-label, .uses-block-label {
  font-family: var(--font-mono, ui-monospace, monospace);
  color: var(--cw-accent);
  font-size: 11px;
  letter-spacing: 0.1em;
  margin-bottom: 10px;
}

.uses-h1 {
  font-family: var(--font-display, 'Space Grotesk', sans-serif);
  font-size: clamp(40px, 5vw, 56px);
  letter-spacing: -0.03em;
  margin-bottom: 16px;
}

.uses-lede {
  font-size: 18px;
  line-height: 1.5;
  color: var(--cw-ink-dim);
  max-width: 720px;
  margin: 0 0 56px;
}

.uses-lede a {
  color: var(--cw-accent);
  text-decoration: underline;
}

.uses-grid {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 40px 56px;
}

.uses-block-label { color: var(--cw-warm); margin-bottom: 14px; }

.uses-list {
  list-style: none;
  padding: 0;
  margin: 0;
}

.uses-list li {
  padding: 8px 0;
  font-size: 14px;
  line-height: 1.55;
  color: var(--cw-ink-dim);
  border-bottom: 1px dashed var(--cw-line);
}

.uses-name { color: var(--cw-ink); font-weight: 500; }
.uses-note { color: var(--cw-ink-faint); }

@media (max-width: 700px) {
  .uses-container { padding: 0 20px; }
  .uses-grid { grid-template-columns: 1fr; gap: 32px; }
}
</style>

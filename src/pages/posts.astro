---
import Posts from "@/components/Posts.astro";
import Base from "@/layouts/Base.astro";
import { getSinglePage } from "@/lib/contentParser.astro";
import { sortByDate } from "@/lib/utils/sortFunctions";
import writing from "@/data/writing.json";

const posts = await getSinglePage("posts");
const sortedPosts = sortByDate(posts);

const externalWriting = (writing as any[])
  .slice()
  .sort((a, b) => +new Date(b.date) - +new Date(a.date));

function fmtDate(s: string) {
  return new Date(s).toLocaleDateString("en-GB", { month: "short", year: "numeric" });
}
---

<Base title="Posts">
  <div class="posts-page">
    <div class="posts-container">
      <div class="posts-header">
        <div class="posts-label font-mono-bio">// ALL.SEQUENCES</div>
        <h1 class="posts-title">All posts</h1>
        <p class="posts-sub">Every entry, chronologically. Hover a row — the helix lights up; an antibody binds.</p>
      </div>
      <Posts className="mb-12" posts={sortedPosts} />

      <!-- External writing — articles + reports hosted on other publications -->
      {externalWriting.length > 0 && (
        <aside class="ext-block">
          <div class="ext-head">
            <div>
              <div class="ext-label font-mono-bio">// FROM ELSEWHERE</div>
              <h2 class="ext-h2">Articles published on other sites</h2>
              <p class="ext-sub">Earlier pieces written for The Hyve, D4 Pharma, and other venues. The full archive lives at <a href="/writing">/writing</a>.</p>
            </div>
          </div>
          <div class="ext-grid">
            {externalWriting.map((w: any) => (
              <a href={w.url} target="_blank" rel="noopener noreferrer" class="ext-card">
                <div class="ext-meta-row">
                  <span class="ext-type font-mono-bio">{w.type.toUpperCase()}</span>
                  <span class="ext-date font-mono-bio">{fmtDate(w.date)}</span>
                </div>
                <h3 class="ext-title">{w.title}</h3>
                <div class="ext-venue">{w.venue}{w.coauthors ? ` · ${w.coauthors}` : ""}</div>
                {w.annotation && <p class="ext-annot">{w.annotation}</p>}
                <div class="ext-cta font-mono-bio">READ ON {w.venue.split(" ")[0].toUpperCase()} ↗</div>
              </a>
            ))}
          </div>
        </aside>
      )}

      <!-- Cross-links to secondary pages -->
      <aside class="explore-block">
        <div class="explore-label font-mono-bio">// MORE FROM THIS SITE</div>
        <div class="explore-grid">
          <a href="/business" class="explore-card">
            <div class="explore-card-name">Business</div>
            <div class="explore-card-desc">Stocks, M&A, drug approvals across 33 antibody-drug companies.</div>
          </a>
          <a href="/work" class="explore-card">
            <div class="explore-card-name">Work</div>
            <div class="explore-card-desc">Selected case studies — what I've actually shipped.</div>
          </a>
          <a href="/talks" class="explore-card">
            <div class="explore-card-name">Talks</div>
            <div class="explore-card-desc">Speaking history + topics I cover at events.</div>
          </a>
          <a href="/writing" class="explore-card">
            <div class="explore-card-name">Writing elsewhere</div>
            <div class="explore-card-desc">External articles and reports — Hyve era and beyond.</div>
          </a>
          <a href="/now" class="explore-card">
            <div class="explore-card-name">Now</div>
            <div class="explore-card-desc">What I'm focused on this month.</div>
          </a>
          <a href="/uses" class="explore-card">
            <div class="explore-card-name">Uses</div>
            <div class="explore-card-desc">The tools I actually use, day in and out.</div>
          </a>
        </div>
      </aside>
    </div>
  </div>
</Base>

<style>
.posts-page {
  padding-bottom: 80px;
}

.posts-container {
  max-width: 1200px;
  margin: 0 auto;
  padding: 60px 40px 0;
}

.posts-header {
  margin-bottom: 48px;
}

.posts-label {
  color: var(--rt-accent);
  font-size: 11px;
  letter-spacing: 0.1em;
  margin-bottom: 10px;
}

.posts-title {
  font-family: var(--font-display, 'Space Grotesk', sans-serif);
  font-size: clamp(40px, 5vw, 64px);
  letter-spacing: -0.03em;
  margin-bottom: 12px;
}

.posts-sub {
  color: var(--rt-ink-dim);
  font-size: 17px;
  max-width: 620px;
  margin: 0;
}

/* External writing block */
.ext-block {
  margin-top: 64px;
  padding-top: 32px;
  border-top: 1px dashed var(--rt-line-strong);
}

.ext-head {
  margin-bottom: 24px;
}

.ext-label {
  color: var(--rt-warm);
  font-size: 11px;
  letter-spacing: 0.1em;
  margin-bottom: 8px;
}

.ext-h2 {
  font-family: var(--font-display, 'Space Grotesk', sans-serif);
  font-size: 26px;
  letter-spacing: -0.02em;
  margin: 0 0 8px;
}

.ext-sub {
  font-size: 14px;
  color: var(--rt-ink-dim);
  margin: 0;
  max-width: 680px;
}

.ext-sub a {
  color: var(--rt-accent);
  text-decoration: underline;
}

.ext-grid {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 16px;
}

.ext-card {
  display: flex;
  flex-direction: column;
  padding: 22px 22px 18px;
  border: 1px solid var(--rt-line);
  border-left: 3px solid var(--rt-warm);
  background: var(--rt-bg-elev);
  border-radius: 4px;
  text-decoration: none;
  transition: border-color 0.2s, transform 0.2s;
}

.ext-card:hover {
  border-color: var(--rt-accent);
  border-left-color: var(--rt-accent);
  transform: translateY(-2px);
}

.ext-meta-row {
  display: flex;
  justify-content: space-between;
  align-items: baseline;
  margin-bottom: 10px;
}

.ext-type {
  font-size: 10px;
  letter-spacing: 0.1em;
  color: var(--rt-warm);
}

.ext-date {
  font-size: 10px;
  color: var(--rt-ink-faint);
  letter-spacing: 0.06em;
}

.ext-title {
  font-family: var(--font-display, 'Space Grotesk', sans-serif);
  font-size: 17px;
  line-height: 1.25;
  margin: 0 0 6px;
  letter-spacing: -0.01em;
  color: var(--rt-ink);
}

.ext-card:hover .ext-title { color: var(--rt-accent); }

.ext-venue {
  font-size: 12px;
  color: var(--rt-ink-faint);
  margin-bottom: 10px;
}

.ext-annot {
  font-size: 13px;
  line-height: 1.5;
  color: var(--rt-ink-dim);
  margin: 0 0 14px;
  flex: 1;
}

.ext-cta {
  font-size: 10px;
  letter-spacing: 0.1em;
  color: var(--rt-accent);
  margin-top: auto;
}

/* Explore block at bottom */
.explore-block {
  margin-top: 64px;
  padding-top: 32px;
  border-top: 1px dashed var(--rt-line-strong);
}

.explore-label {
  color: var(--rt-warm);
  font-size: 11px;
  letter-spacing: 0.1em;
  margin-bottom: 18px;
}

.explore-grid {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 14px;
}

.explore-card {
  display: block;
  padding: 16px 18px 14px;
  border: 1px solid var(--rt-line);
  background: var(--rt-bg-elev);
  border-radius: 4px;
  text-decoration: none;
  transition: border-color 0.2s, transform 0.2s;
}

.explore-card:hover {
  border-color: var(--rt-accent);
  transform: translateY(-2px);
}

.explore-card-name {
  font-family: var(--font-display, 'Space Grotesk', sans-serif);
  font-size: 16px;
  color: var(--rt-ink);
  font-weight: 500;
  letter-spacing: -0.01em;
  margin-bottom: 6px;
}

.explore-card-desc {
  font-size: 13px;
  line-height: 1.45;
  color: var(--rt-ink-dim);
}

@media (max-width: 900px) {
  .explore-grid { grid-template-columns: repeat(2, 1fr); }
  .ext-grid     { grid-template-columns: repeat(2, 1fr); }
}

@media (max-width: 640px) {
  .posts-container {
    padding: 40px 20px 0;
  }
  .explore-grid { grid-template-columns: 1fr; }
  .ext-grid     { grid-template-columns: 1fr; }
}
</style>

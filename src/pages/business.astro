---
import Base from "@/layouts/Base.astro";
import companies from "@/data/companies.json";
import pricesData from "@/data/prices.json";
import { getCollection } from "astro:content";
import dateFormat from "@/lib/utils/dateFormat";

const prices: Record<string, any> = (pricesData as any)?.prices ?? {};
const fetchedAt: string = (pricesData as any)?.fetched_at ?? "—";

// Optional: business-news.json (Phase 2 output) — gracefully degrade if missing
let businessNews: any = { fetched_at: "—", items: [] };
try {
  // @ts-ignore — optional file; may not exist on first build
  businessNews = (await import("@/data/business-news.json")).default;
} catch {}

const newsItems: any[] = businessNews?.items ?? [];
const newsByCategory: Record<string, any[]> = {};
for (const item of newsItems) {
  const cat = item.category || "Other";
  if (!newsByCategory[cat]) newsByCategory[cat] = [];
  newsByCategory[cat].push(item);
}
const newsCats = ["M&A", "Approvals", "Trials", "Earnings", "Pipeline", "Other"]
  .filter((c) => newsByCategory[c]?.length);

// Group companies by category
const grouped: Record<string, any[]> = {};
for (const c of companies as any[]) {
  if (!grouped[c.category]) grouped[c.category] = [];
  grouped[c.category].push(c);
}
const catOrder = ["Big Pharma", "Antibody Pure-Play", "AI-Native Platform", "Tools / Platform", "CDMO"];

// Latest market-analysis post if any (slug starts with "business-")
const allPosts = await getCollection("posts");
const marketPosts = allPosts
  .filter((p: any) => !p.data.draft && /^business-|^market-/.test(p.id))
  .sort((a: any, b: any) => +new Date(b.data.date ?? 0) - +new Date(a.data.date ?? 0));
const latestMarket = marketPosts[0];

// Build ticker tape: every company with a price, looped twice for seamless marquee
const tape = (companies as any[])
  .map((c) => ({ ...c, price: prices[c.ticker] }))
  .filter((c) => c.price);
---

<Base
  title="Business — antibody discovery markets"
  meta_title="Business — antibody discovery markets, M&A, drug approvals"
  description="Tracking the business of antibody discovery: stock prices, M&A, drug approvals, and earnings of the companies that matter."
>
  <!-- Ticker tape -->
  <div class="ticker-wrap" aria-label="Stock ticker">
    <div class="ticker-track">
      {[...tape, ...tape].map((c) => {
        const p = c.price;
        const up = p.pct_change_1d >= 0;
        return (
          <div class={`tick ${up ? "tick-up" : "tick-down"}`}>
            <span class="tick-symbol">{c.ticker}</span>
            <span class="tick-price">{p.last_close} {p.currency}</span>
            <span class="tick-change">{up ? "▲" : "▼"} {Math.abs(p.pct_change_1d).toFixed(2)}%</span>
          </div>
        );
      })}
    </div>
  </div>

  <section class="biz-header">
    <div class="biz-container">
      <div class="biz-label">// BUSINESS</div>
      <h1 class="biz-h1">
        The <span class="warm-text serif-italic">business</span> of antibody discovery
      </h1>
      <p class="biz-lede">
        Stock movement, M&amp;A, drug approvals, and earnings across the companies actually building, manufacturing, and commercializing therapeutic antibodies. Curated. No fluff. <span class="biz-fetched">Prices updated {fetchedAt}.</span>
      </p>
    </div>
  </section>

  {latestMarket && (
    <section class="biz-section">
      <div class="biz-container">
        <div class="biz-row-label">// LATEST MARKET ANALYSIS</div>
        <a class="market-card" href={`/blog/${latestMarket.id}`}>
          <div class="market-date font-mono-bio">{dateFormat(latestMarket.data.date).toUpperCase()}</div>
          <h3 class="market-title">{latestMarket.data.title}</h3>
          {latestMarket.data.description && <p class="market-desc">{latestMarket.data.description}</p>}
          <div class="market-cta font-mono-bio">READ THE WEEK →</div>
        </a>
      </div>
    </section>
  )}

  {newsCats.length > 0 && (
    <section class="biz-section">
      <div class="biz-container">
        <div class="biz-row-label">// THIS WEEK IN ANTIBODY BUSINESS</div>
        <h2 class="biz-h2">News digest</h2>
        <div class="news-grid">
          {newsCats.map((cat) => (
            <div class="news-col">
              <div class="news-cat-head font-mono-bio">{cat.toUpperCase()}</div>
              <ul class="news-list">
                {newsByCategory[cat].slice(0, 6).map((item: any) => (
                  <li class="news-item">
                    <a href={item.url} target="_blank" rel="noopener" class="news-link">
                      <span class="news-source font-mono-bio">{item.source}</span>
                      <span class="news-headline">{item.title}</span>
                    </a>
                    {item.tickers?.length > 0 && (
                      <div class="news-tickers">
                        {item.tickers.map((t: string) => (<span class="news-ticker-chip">{t}</span>))}
                      </div>
                    )}
                  </li>
                ))}
              </ul>
            </div>
          ))}
        </div>
        <p class="biz-foot">News updated {businessNews.fetched_at}. Sources: NewsAPI + Reuters/Bloomberg/FT via Google News RSS.</p>
      </div>
    </section>
  )}

  <section class="biz-section">
    <div class="biz-container">
      <div class="biz-row-label">// COMPANY DIRECTORY</div>
      <h2 class="biz-h2">Companies I track</h2>
      <p class="biz-sub">Curated list of the {companies.length} companies whose moves shape antibody discovery — by category, with why each one matters.</p>

      {catOrder.filter((cat) => grouped[cat]?.length).map((cat) => (
        <div class="cat-block">
          <h3 class="cat-name">{cat}</h3>
          <div class="cat-grid">
            {grouped[cat].map((c: any) => {
              const p = prices[c.ticker];
              const up = p ? p.pct_change_1d >= 0 : null;
              return (
                <div class="co-card">
                  <div class="co-head">
                    <a href={c.url} target="_blank" rel="noopener" class="co-name">{c.name}</a>
                    <span class="co-ticker font-mono-bio">{c.ticker}</span>
                  </div>
                  {p ? (
                    <div class="co-price-row">
                      <span class="co-price">{p.last_close} {p.currency}</span>
                      <span class={`co-pct ${up ? "co-up" : "co-down"}`}>{up ? "▲" : "▼"} {Math.abs(p.pct_change_1d).toFixed(2)}% 1d</span>
                      <span class={`co-pct ${p.pct_change_5d >= 0 ? "co-up" : "co-down"}`}>{p.pct_change_5d >= 0 ? "▲" : "▼"} {Math.abs(p.pct_change_5d).toFixed(2)}% 5d</span>
                    </div>
                  ) : (
                    <div class="co-price-row co-noprice">price unavailable</div>
                  )}
                  <p class="co-why">{c.why}</p>
                </div>
              );
            })}
          </div>
        </div>
      ))}
    </div>
  </section>

  <section class="biz-section biz-disclaimer">
    <div class="biz-container">
      <p>
        <strong>Disclaimer.</strong> This page is editorial, not investment advice. Prices are end-of-day snapshots refreshed weekly. Currency is the listing exchange's native currency. Tickers are illustrative; many companies trade on multiple exchanges.
      </p>
    </div>
  </section>
</Base>

<style>
/* Ticker tape */
.ticker-wrap {
  border-top: 1px solid var(--cw-line);
  border-bottom: 1px solid var(--cw-line);
  background: var(--cw-bg-elev);
  overflow: hidden;
  white-space: nowrap;
  padding: 10px 0;
}

.ticker-track {
  display: inline-flex;
  gap: 32px;
  animation: tickerScroll 90s linear infinite;
  will-change: transform;
}

@keyframes tickerScroll {
  from { transform: translateX(0); }
  to   { transform: translateX(-50%); }
}

.tick {
  display: inline-flex;
  gap: 8px;
  font-family: var(--font-mono, ui-monospace, monospace);
  font-size: 12px;
  white-space: nowrap;
  flex-shrink: 0;
}

.tick-symbol { font-weight: 600; color: var(--cw-ink); }
.tick-price  { color: var(--cw-ink-dim); }
.tick-change { letter-spacing: 0.02em; }
.tick-up    .tick-change { color: #4ec47b; }
.tick-down  .tick-change { color: #d96565; }
.tick-up    .tick-symbol { border-left: 2px solid #4ec47b; padding-left: 8px; }
.tick-down  .tick-symbol { border-left: 2px solid #d96565; padding-left: 8px; }

.ticker-wrap:hover .ticker-track {
  animation-play-state: paused;
}

/* Layout */
.biz-container {
  max-width: 1200px;
  margin: 0 auto;
  padding: 0 40px;
}

.biz-header { padding: 60px 0 32px; }
.biz-section { padding: 32px 0 16px; }

.biz-label, .biz-row-label, .news-cat-head, .market-cta, .market-date {
  font-family: var(--font-mono, ui-monospace, monospace);
  font-size: 11px;
  letter-spacing: 0.1em;
}

.biz-label, .biz-row-label { color: var(--cw-accent); margin-bottom: 12px; }

.biz-h1 {
  font-family: var(--font-display, 'Space Grotesk', sans-serif);
  font-size: clamp(40px, 5vw, 60px);
  letter-spacing: -0.03em;
  margin-bottom: 16px;
  line-height: 1.05;
}

.warm-text  { color: var(--cw-warm); }
.serif-italic {
  font-family: var(--font-serif, 'Instrument Serif', serif);
  font-style: italic;
  font-weight: 400;
}

.biz-lede {
  font-size: 18px;
  line-height: 1.5;
  color: var(--cw-ink-dim);
  max-width: 820px;
  margin: 0;
}

.biz-fetched {
  display: inline-block;
  margin-left: 6px;
  color: var(--cw-ink-faint);
  font-size: 14px;
}

.biz-h2 {
  font-family: var(--font-display, 'Space Grotesk', sans-serif);
  font-size: 28px;
  margin: 4px 0 8px;
  letter-spacing: -0.02em;
}

.biz-sub {
  font-size: 14px;
  color: var(--cw-ink-dim);
  margin: 0 0 32px;
}

.biz-foot {
  font-size: 12px;
  color: var(--cw-ink-faint);
  margin-top: 20px;
}

/* Market card */
.market-card {
  display: block;
  padding: 24px 28px;
  border: 1px solid var(--cw-line);
  border-left: 3px solid var(--cw-warm);
  background: var(--cw-bg-elev);
  border-radius: 4px;
  text-decoration: none;
  transition: border-color 0.2s, transform 0.2s;
}

.market-card:hover {
  border-color: var(--cw-accent);
  transform: translateY(-2px);
}

.market-date { color: var(--cw-warm); margin-bottom: 8px; }

.market-title {
  font-family: var(--font-display, 'Space Grotesk', sans-serif);
  font-size: 22px;
  margin: 0 0 8px;
  letter-spacing: -0.01em;
  color: var(--cw-ink);
}

.market-desc {
  font-size: 14px;
  line-height: 1.5;
  color: var(--cw-ink-dim);
  margin: 0 0 12px;
}

.market-cta { color: var(--cw-accent); }

/* News grid (Phase 2) */
.news-grid {
  display: grid;
  grid-template-columns: repeat(2, 1fr);
  gap: 32px 40px;
}

.news-cat-head {
  color: var(--cw-warm);
  margin-bottom: 14px;
  padding-bottom: 8px;
  border-bottom: 1px solid var(--cw-line-strong);
}

.news-list { list-style: none; padding: 0; margin: 0; }

.news-item {
  padding: 10px 0;
  border-bottom: 1px dashed var(--cw-line);
}

.news-link {
  display: block;
  text-decoration: none;
  color: inherit;
}

.news-source {
  font-size: 10px;
  color: var(--cw-ink-faint);
  letter-spacing: 0.06em;
  margin-bottom: 4px;
  display: block;
}

.news-headline {
  display: block;
  font-size: 14px;
  line-height: 1.4;
  color: var(--cw-ink);
}

.news-link:hover .news-headline { color: var(--cw-accent); }

.news-tickers {
  display: flex;
  flex-wrap: wrap;
  gap: 4px;
  margin-top: 6px;
}

.news-ticker-chip {
  font-family: var(--font-mono, ui-monospace, monospace);
  font-size: 9px;
  letter-spacing: 0.06em;
  padding: 2px 6px;
  border: 1px solid var(--cw-line-strong);
  border-radius: 2px;
  color: var(--cw-warm);
}

/* Company directory */
.cat-block { margin-bottom: 48px; }

.cat-name {
  font-family: var(--font-display, 'Space Grotesk', sans-serif);
  font-size: 18px;
  letter-spacing: -0.01em;
  margin: 0 0 16px;
  padding-bottom: 8px;
  border-bottom: 1px solid var(--cw-line-strong);
  color: var(--cw-warm);
}

.cat-grid {
  display: grid;
  grid-template-columns: repeat(auto-fill, minmax(280px, 1fr));
  gap: 14px;
}

.co-card {
  padding: 16px 18px 14px;
  border: 1px solid var(--cw-line);
  background: var(--cw-bg-elev);
  border-radius: 4px;
  display: flex;
  flex-direction: column;
  gap: 8px;
}

.co-head {
  display: flex;
  justify-content: space-between;
  align-items: baseline;
  gap: 8px;
}

.co-name {
  font-family: var(--font-display, 'Space Grotesk', sans-serif);
  font-weight: 500;
  font-size: 14px;
  color: var(--cw-ink);
  text-decoration: none;
  letter-spacing: -0.01em;
}

.co-name:hover { color: var(--cw-accent); }

.co-ticker {
  font-size: 10px;
  letter-spacing: 0.08em;
  color: var(--cw-ink-faint);
}

.co-price-row {
  display: flex;
  flex-wrap: wrap;
  gap: 10px;
  align-items: baseline;
  font-family: var(--font-mono, ui-monospace, monospace);
  font-size: 12px;
}

.co-price { color: var(--cw-ink); font-weight: 600; }

.co-pct  {
  font-size: 11px;
  letter-spacing: 0.02em;
  padding: 2px 6px;
  border-radius: 2px;
}

.co-up   { color: #4ec47b; background: color-mix(in srgb, #4ec47b 10%, transparent); }
.co-down { color: #d96565; background: color-mix(in srgb, #d96565 10%, transparent); }
.co-noprice { color: var(--cw-ink-faint); font-style: italic; }

.co-why {
  font-size: 12px;
  line-height: 1.5;
  color: var(--cw-ink-dim);
  margin: 0;
}

/* Disclaimer */
.biz-disclaimer { padding: 32px 0 80px; }
.biz-disclaimer p {
  font-size: 12px;
  color: var(--cw-ink-faint);
  line-height: 1.55;
  border-top: 1px solid var(--cw-line);
  padding-top: 18px;
  margin: 0;
  max-width: 820px;
}

@media (max-width: 800px) {
  .biz-container { padding: 0 20px; }
  .news-grid { grid-template-columns: 1fr; gap: 24px; }
  .cat-grid { grid-template-columns: 1fr; }
  .ticker-track { animation-duration: 60s; }
}
</style>

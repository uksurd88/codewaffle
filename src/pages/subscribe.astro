---
import Base from "@/layouts/Base.astro";
---

<Base
  title="Subscribe"
  meta_title="Subscribe — Sukhi Singh"
  description="Weekly notes from inside antibody discovery and AI in pharma. No fluff, no spam."
>
  <section class="sub-section">
    <div class="sub-container">
      <div class="sub-label">// SUBSCRIBE</div>
      <h1 class="sub-h1">
        Weekly notes from inside <span class="warm-text">antibody discovery × AI</span>
      </h1>
      <p class="sub-lede">
        One email a week. What the literature actually says, what the platforms get wrong, and what to build next. Written by a working bioinformatician, not a content team.
      </p>

      <form
        action="https://buttondown.com/api/emails/embed-subscribe/ssingh"
        method="post"
        target="popupwindow"
        onsubmit="window.open('https://buttondown.com/ssingh', 'popupwindow')"
        class="sub-form"
      >
        <input
          type="email"
          name="email"
          placeholder="you@email.com"
          required
          aria-label="Email address"
          class="sub-input"
        />
        <button type="submit" class="sub-btn">Subscribe</button>
      </form>

      <p class="sub-fineprint">
        Powered by Buttondown. No spam. Unsubscribe in one click. Your address never gets shared.
      </p>

      <div class="sub-list">
        <div class="sub-list-label">// WHAT TO EXPECT</div>
        <ul>
          <li>3 things from the past week's literature, with my take on each</li>
          <li>A short note on what's actually shipping in industry vs. what's just PR</li>
          <li>The occasional rant when a press release oversells AlphaFold</li>
          <li>Links to my own work and the things I'm building this month</li>
        </ul>
      </div>
    </div>
  </section>
</Base>

<style>
.sub-section { padding: 80px 0 120px; }

.sub-container {
  max-width: 720px;
  margin: 0 auto;
  padding: 0 40px;
}

.sub-label, .sub-list-label {
  font-family: var(--font-mono, ui-monospace, monospace);
  color: var(--cw-accent);
  font-size: 11px;
  letter-spacing: 0.1em;
  margin-bottom: 10px;
}

.sub-h1 {
  font-family: var(--font-display, 'Space Grotesk', sans-serif);
  font-size: clamp(38px, 5vw, 52px);
  letter-spacing: -0.03em;
  line-height: 1.1;
  margin-bottom: 20px;
}

.warm-text { color: var(--cw-warm); }

.sub-lede {
  font-size: 19px;
  line-height: 1.5;
  color: var(--cw-ink-dim);
  margin: 0 0 36px;
}

.sub-form {
  display: flex;
  gap: 8px;
  margin-bottom: 12px;
}

.sub-input {
  flex: 1;
  padding: 14px 16px;
  font-size: 16px;
  font-family: inherit;
  border: 1px solid var(--cw-line-strong);
  background: var(--cw-bg);
  color: var(--cw-ink);
  border-radius: 4px;
  outline: none;
  transition: border-color 0.2s;
}

.sub-input:focus { border-color: var(--cw-accent); }

.sub-btn {
  padding: 14px 24px;
  font-size: 14px;
  font-weight: 600;
  font-family: var(--font-display, 'Space Grotesk', sans-serif);
  letter-spacing: 0.02em;
  border: none;
  background: var(--cw-accent);
  color: var(--cw-bg);
  cursor: pointer;
  border-radius: 4px;
  transition: opacity 0.2s;
}

.sub-btn:hover { opacity: 0.85; }

.sub-fineprint {
  font-size: 12px;
  color: var(--cw-ink-faint);
  margin: 0 0 56px;
}

.sub-list {
  border-top: 1px solid var(--cw-line);
  padding-top: 28px;
}

.sub-list-label { color: var(--cw-warm); margin-bottom: 14px; }

.sub-list ul {
  list-style: none;
  padding: 0;
  margin: 0;
}

.sub-list li {
  padding: 8px 0;
  font-size: 14px;
  line-height: 1.6;
  color: var(--cw-ink-dim);
}

.sub-list li::before {
  content: '◇ ';
  color: var(--cw-accent);
  margin-right: 6px;
}

@media (max-width: 600px) {
  .sub-container { padding: 0 20px; }
  .sub-form { flex-direction: column; }
}
</style>

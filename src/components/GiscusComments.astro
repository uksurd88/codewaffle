---
// Giscus comments backed by GitHub Discussions.
// Repo must have Discussions enabled and giscus app installed: https://giscus.app
---

<section class="section pt-0">
  <div class="container">
    <div class="row justify-center">
      <div class="md:col-10">
        <div id="giscus-comments" class="mt-8">
          <script
            src="https://giscus.app/client.js"
            data-repo="uksurd88/radtech"
            data-repo-id="MDEwOlJlcG9zaXRvcnkzOTk3MDAyMQ=="
            data-category="Announcements"
            data-category-id="DIC_kwDOAmHk5c4C7jQG"
            data-mapping="pathname"
            data-strict="0"
            data-reactions-enabled="1"
            data-emit-metadata="0"
            data-input-position="top"
            data-theme="preferred_color_scheme"
            data-lang="en"
            data-loading="lazy"
            crossorigin="anonymous"
            async
          ></script>
        </div>
      </div>
    </div>
  </div>
</section>

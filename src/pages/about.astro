---
import WaffleHero from "@/components/WaffleHero.astro";
import Base from "@/layouts/Base.astro";
import { markdownify } from "@/lib/utils/textConverter";
import type { CollectionEntry } from "astro:content";
import { getEntry, render } from "astro:content";

const entry = (await getEntry("about", "-index")) as CollectionEntry<"about">;
const { Content } = await render(entry);
const { title, meta_title, image, what_i_do } = entry.data;
---

<Base title={title} meta_title={meta_title} image={image}>
  <div id="about-page">
    <canvas id="dna-strip-right" aria-hidden="true"></canvas>
    <!-- Header -->
    <section class="about-header">
      <div class="about-container">
        <div class="about-label font-mono-bio">// ABOUT</div>
        <h1 class="about-name">
          Sukhi <span class="serif-italic warm-text">Singh</span>
        </h1>
        <p class="about-lede serif-italic">
          I work on data platforms for antibody discovery — the layer between a sequencer and a decision.
          Currently Product Manager at ENPICOM, Eindhoven.
        </p>
      </div>
    </section>

    <!-- Two-col: Sequence ID + full bio -->
    <section class="about-bio-section">
      <div class="about-container">
        <div class="about-bio-grid">
          <div>
            <div class="col-label font-mono-bio">// SEQUENCE.ID</div>
            <div class="sequence-list">
              <div><span class="accent-arrow">→</span> ENPICOM · Product</div>
              <div><span class="accent-arrow">→</span> Amsterdam, NL</div>
              <div><span class="accent-arrow">→</span> Pistoia Alliance</div>
              <div><span class="accent-arrow">→</span> Bioinformatics → Product</div>
            </div>
            {image && (
              <div class="author-img-wrap">
                <img src={image} alt={title} class="author-img" width="240" loading="lazy" />
              </div>
            )}
          </div>
          <div>
            <div class="col-label font-mono-bio">// WHAT.I.WRITE.ABOUT</div>
            <div class="prose-bio content">
              <Content />
            </div>
            <a
              href="https://www.linkedin.com/in/vanbug"
              target="_blank"
              rel="noopener"
              class="cw-btn"
            >
              <span>Get In Touch</span>
              <span>→</span>
            </a>
          </div>
        </div>
      </div>
    </section>

    <!-- What I do -->
    {what_i_do?.items?.length > 0 && (
      <section class="what-i-do-section">
        <div class="about-container">
          <div class="about-label font-mono-bio">// WHAT.I.DO</div>
          <h2 class="wid-title">{what_i_do.title}</h2>
          <div class="wid-grid">
            {what_i_do.items.map((item: any) => (
              <div class="wid-card">
                <h3 class="wid-card-title">{item.title}</h3>
                <p class="wid-card-desc">{item.description}</p>
              </div>
            ))}
          </div>
        </div>
      </section>
    )}

    <!-- Helix viz banner -->
    <section class="about-container">
      <div class="helix-viz">
        <WaffleHero variant="helix" intensity={60} height="100%" />
      </div>
    </section>
  </div>
</Base>

<style>
#about-page {
  padding-bottom: 80px;
  position: relative;
}

#dna-strip-right {
  display: none;
  position: absolute;
  top: 0;
  /* Sit just outside the 1000px content container: 500px half-width + small gap */
  right: max(12px, calc(50% - 520px));
  width: 44px;
  height: 100%;
  pointer-events: none;
}

@media (min-width: 1100px) {
  #dna-strip-right { display: block; }
}

.about-container {
  max-width: 1000px;
  margin: 0 auto;
  padding: 0 40px;
}

/* Header */
.about-header {
  padding: 60px 0 48px;
}

.about-label {
  color: var(--cw-accent);
  font-size: 11px;
  letter-spacing: 0.1em;
  margin-bottom: 10px;
}

.about-name {
  font-family: var(--font-display, 'Space Grotesk', sans-serif);
  font-size: clamp(48px, 6vw, 64px);
  letter-spacing: -0.03em;
  margin-bottom: 24px;
}

.serif-italic {
  font-family: var(--font-serif, 'Instrument Serif', serif);
  font-style: italic;
  font-weight: 400;
}

.warm-text { color: var(--cw-warm); }
.accent-text { color: var(--cw-accent); }

.about-lede {
  font-size: 26px;
  line-height: 1.35;
  color: var(--cw-ink-dim);
  max-width: 720px;
  font-weight: 400;
  margin: 0;
}

/* Bio section */
.about-bio-section {
  padding-bottom: 80px;
}

.about-bio-grid {
  display: grid;
  grid-template-columns: 1fr 2fr;
  gap: 60px;
}

.col-label {
  font-size: 10px;
  letter-spacing: 0.14em;
  color: var(--cw-ink-faint);
  margin-bottom: 16px;
}

.sequence-list {
  font-size: 15px;
  line-height: 1.8;
  color: var(--cw-ink-dim);
  margin-bottom: 32px;
}

.accent-arrow {
  color: var(--cw-accent);
  margin-right: 6px;
}

.author-img-wrap {
  border-radius: 8px;
  overflow: hidden;
  max-width: 200px;
}

.author-img {
  width: 100%;
  height: auto;
  display: block;
}

.prose-bio {
  font-size: 15px;
  line-height: 1.65;
  color: var(--cw-ink-dim);
  margin-bottom: 28px;
}

/* CTA button */
.cw-btn {
  display: inline-flex;
  align-items: center;
  gap: 8px;
  padding: 10px 20px;
  border-radius: 999px;
  border: 1px solid var(--cw-ink);
  font-family: var(--font-display, 'Space Grotesk', sans-serif);
  font-weight: 500;
  font-size: 13px;
  color: var(--cw-ink);
  text-decoration: none;
  transition: background 0.2s, color 0.2s;
}

.cw-btn:hover {
  background: var(--cw-ink);
  color: var(--cw-bg);
}

/* What I do */
.what-i-do-section {
  padding-bottom: 60px;
}

.wid-title {
  font-size: 32px;
  margin-bottom: 40px;
}

.wid-grid {
  display: grid;
  grid-template-columns: repeat(2, 1fr);
  gap: 24px;
}

.wid-card {
  padding: 24px;
  border: 1px solid var(--cw-line);
  background: var(--cw-bg-elev);
}

.wid-card-title {
  font-family: var(--font-display, 'Space Grotesk', sans-serif);
  font-size: 16px;
  font-weight: 600;
  margin-bottom: 10px;
  color: var(--cw-ink);
  letter-spacing: -0.01em;
}

.wid-card-desc {
  font-size: 14px;
  line-height: 1.6;
  color: var(--cw-ink-dim);
  margin: 0;
}

/* Helix banner */
.helix-viz {
  position: relative;
  height: 280px;
  border: 1px solid var(--cw-line);
  background: var(--cw-bg-elev);
  overflow: hidden;
  margin-top: 20px;
}

@media (max-width: 768px) {
  .about-container { padding: 0 20px; }

  .about-bio-grid {
    grid-template-columns: 1fr;
    gap: 40px;
  }

  .wid-grid {
    grid-template-columns: 1fr;
  }
}
</style>

<script>
(function () {
  function hex(h: string, a: number): string {
    const c = h.replace('#', '');
    const r = parseInt(c.slice(0,2),16), g = parseInt(c.slice(2,4),16), b = parseInt(c.slice(4,6),16);
    return `rgba(${r},${g},${b},${Math.max(0,Math.min(1,a))})`;
  }

  function initDnaStrip() {
    const canvas = document.getElementById('dna-strip-right') as HTMLCanvasElement | null;
    if (!canvas) return;
    const ctx = canvas.getContext('2d');
    if (!ctx) return;

    const dpr = Math.min(window.devicePixelRatio || 1, 2);
    const resize = () => {
      const r = canvas.getBoundingClientRect();
      canvas.width = r.width * dpr;
      canvas.height = r.height * dpr;
    };
    resize();
    const ro = new ResizeObserver(resize);
    ro.observe(canvas);

    const bases = ['A', 'C', 'G', 'T'];
    let t = 0;
    let rafId = 0;
    const isDark = () => document.documentElement.classList.contains('dark');

    const draw = () => {
      const w = canvas.width, h = canvas.height;
      t += 0.007;
      ctx.clearRect(0, 0, w, h);

      const dark = isDark();
      const accent = dark ? '#6FE3D8' : '#178F84';
      const warm   = dark ? '#E8B168' : '#B87A28';
      const spacing = 28 * dpr;

      for (let col = 0; col < 2; col++) {
        const cx = w * (col === 0 ? 0.28 : 0.72);
        const scrollPos = t * spacing * (col === 0 ? 0.55 : -0.42);

        ctx.strokeStyle = hex(accent, 0.18);
        ctx.lineWidth = 1 * dpr;
        ctx.beginPath(); ctx.moveTo(cx, 0); ctx.lineTo(cx, h); ctx.stroke();

        ctx.font = `${11 * dpr}px ui-monospace, monospace`;
        ctx.textAlign = 'center';
        ctx.textBaseline = 'middle';

        const firstRow = Math.floor(scrollPos / spacing) - 1;
        const lastRow  = Math.ceil((scrollPos + h) / spacing) + 1;

        for (let row = firstRow; row <= lastRow; row++) {
          const y = row * spacing - scrollPos;
          if (y < -spacing || y > h + spacing) continue;
          const base  = bases[((row % 4) + 4) % 4];
          const left  = row % 2 === 0;
          const color = (base === 'A' || base === 'T') ? accent : warm;

          ctx.fillStyle = hex(color, 0.72);
          ctx.fillText(base, cx + (left ? -9 : 9) * dpr, y);
          ctx.strokeStyle = hex(color, 0.38);
          ctx.lineWidth = 1 * dpr;
          ctx.beginPath();
          ctx.moveTo(cx, y);
          ctx.lineTo(cx + (left ? -4 : 4) * dpr, y);
          ctx.stroke();
        }
      }

      rafId = requestAnimationFrame(draw);
    };
    rafId = requestAnimationFrame(draw);
  }

  initDnaStrip();
  document.addEventListener('astro:after-swap', initDnaStrip);
})();
</script>
